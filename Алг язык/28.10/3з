подписчики := []

АЛГОРИТМ Подписать(id)
НАЧАЛО
    ЕСЛИ id НЕ СОДЕРЖИТСЯ В подписчики ТО
        ДОБАВИТЬ id В подписчики
    КОНЕЦ ЕСЛИ
КОНЕЦ

АЛГОРИТМ Отписать(id)
НАЧАЛО
    УДАЛИТЬ id ИЗ подписчики, ЕСЛИ ОН ЕСТЬ
КОНЕЦ

АЛГОРИТМ Вызвать(id, событие)
НАЧАЛО
    ВЫБОР id
        ПРИ 1:
            ВЫВЕСТИ "Экран:", событие
        ПРИ 2:
            ВЫВЕСТИ "Журнал:", событие
        ПРИ 3:
            ВЫВЕСТИ "Разовый обработчик:", событие
            Отписать(3)
    КОНЕЦ ВЫБОРА
КОНЕЦ

АЛГОРИТМ Оповестить(событие)
НАЧАЛО
    копия := КОПИЯ(подписчики)
    ДЛЯ КАЖДОГО id ИЗ копия
        Вызвать(id, событие)
    КОНЕЦ ДЛЯ
КОНЕЦ

АЛГОРИТМ Основной
НАЧАЛО
    Подписать(1)
    Подписать(2)
    Подписать(3)

    Оповестить("Температура 20")
    | Сработают 1, 2, 3. Обработчик 3 отпишется.

    Оповестить("Температура 25")
    | Сработают 1 и 2.

    Отписать(1)
    Оповестить("Температура 30")
    | Сработает только 2.
КОНЕЦ
